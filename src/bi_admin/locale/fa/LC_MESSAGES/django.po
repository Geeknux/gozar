msgstr "کاربرد: /mute <key> <duration>، /unmute <key>"

#: alerts/bot.py:259
#, python-format
msgid "Unknown alert key %(key)s (see /alerts)."
msgstr "کلید هشدار ناشناخته: %(key)s (به /alerts نگاه کنید)."

