msgstr "تاریخ لازم است: 2026-03-21 (میلادی) یا 1405/01/01 (شمسی)"

#: engine/validator.py:432 engine/validator.py:437
msgid "Expected a number"
msgstr "عدد لازم است"

#: engine/validator.py:447
msgid "Expected true or false"
msgstr "true یا false لازم است"

#: engine/validator.py:460
#, python-format
msgid "%(value)r is not a valid %(key)s"
msgstr "%(value)r مقدار معتبری برای %(key)s نیست"

#: engine/validator.py:477
#, python-format
msgid "Sort field %(key)r must be one of the report's measures or dimensions"
msgstr "فیلد مرتب‌سازی %(key)r باید یکی از سنجه‌ها یا ابعاد گزارش باشد"

#: engine/validator.py:493
msgid "limit must be at least 1"
msgstr "limit باید دست‌کم ۱ باشد"

#: engine/validator.py:496
#, python-format
msgid "limit may not exceed %(max)s"
msgstr "limit نمی‌تواند از %(max)s بیشتر باشد"

#: execution/limits.py:34
#, python-format
msgid "The report took longer than %(seconds)s seconds and was stopped."
msgstr "اجرای گزارش بیش از %(seconds)s ثانیه طول کشید و متوقف شد."

