#, python-format
msgid "%(key)s is no longer muted."
msgstr "%(key)s دیگر بی‌صدا نیست."

#: alerts/bot.py:266
msgid "Durations look like 30m, 2h or 1d."
msgstr "مدت را به شکل 30m، 2h یا 1d بنویسید."

#: alerts/bot.py:270
#, python-format
msgid "%(key)s muted until %(time)s."
msgstr "%(key)s تا %(time)s بی‌صدا شد."

#: alerts/bot.py:271
msgid "Unknown command. Send /help for the list."
msgstr "دستور ناشناخته. برای فهرست دستورها /help را بفرستید."

#: alerts/bot.py:324
msgid "the Telegram channel is off"
msgstr "کانال تلگرام خاموش است"

#: alerts/bot.py:328
msgid "Interactive mode is off (GOZAR[\"ALERTS\"][\"TELEGRAM\"][\"INTERACTIVE\"])."
msgstr "حالت تعاملی خاموش است (GOZAR[\"ALERTS\"][\"TELEGRAM\"][\"INTERACTIVE\"])."

